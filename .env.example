# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key
# Optional backup provider, used when every Gemini model fails
GROQ_API_KEY=your_groq_api_key
# Optional: override the Groq model list
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional: secret used to sign the web session cookie
# FLASK_SECRET_KEY=change-me